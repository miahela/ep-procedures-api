# This public API requires no key or account.
# Existing environment variables take precedence over .env.
EP_BASE_URL=https://data.europarl.europa.eu/api/v2
# Relative output paths resolve from your current working directory.
EP_OUTPUT_DIR=ep_api_test_v2_output
EP_TIMEOUT=30
# Seconds between requests. Keep a delay suitable for the API's limits.
EP_REQUEST_DELAY=0.5
EP_MAX_PROCEDURES=50
# Feed fallback uses approximately 30 days per month.
EP_LOOKBACK_MONTHS=3
EP_MEETINGS_HORIZON=50
# Global cap on meetings processed and foreseen-activities calls per run.
EP_MAX_MEETINGS=20
